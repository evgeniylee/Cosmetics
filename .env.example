# ---------- База данных ----------
# Продакшен: строка подключения к PostgreSQL (лучше сервер в Узбекистане).
# Локально можно не заполнять: используется встроенный PGlite, данные в ./.data/pglite
DATABASE_URL=

# ---------- Вход по коду из Telegram ----------
# Токен из https://gateway.telegram.org (раздел API). Без него:
#   - в `npm run dev` работает демо-режим, код 111111;
#   - в продакшене код не отправляется, заказы принимаются со статусом «Требует звонка».
TELEGRAM_GATEWAY_TOKEN=
# Разрешить демо-код 111111 в продакшен-сборке (только для тестов, на боевом сайте не включать)
ALLOW_DEMO_OTP=

# ---------- Уведомления о заказах ----------
# Токен бота от @BotFather и id чата/группы, куда бот будет писать о новых заказах.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# ---------- Telegram Mini App (магазин внутри Telegram) ----------
# Тот же бот (TELEGRAM_BOT_TOKEN): им подписываются данные входа из Mini App.
# Секрет для вебхука бота: любая длинная случайная строка (буквы, цифры, _ и -).
TELEGRAM_WEBHOOK_SECRET=
# Прямая ссылка на Mini App из @BotFather (/newapp), например https://t.me/nabi_shop_bot/shop.
# Нужна для «Ссылки для Telegram» в кабинете креатора.
NEXT_PUBLIC_TG_APP_URL=

# ---------- Админка (/admin) ----------
# Телефоны, которым открыт вход в админку, через запятую. Вход — тем же кодом из Telegram.
ADMIN_PHONES=+998901234567
# Адрес сайта: нужен для ссылки «Открыть в админке» в уведомлении о заказе
SITE_URL=https://nabi.uz
# Куда сохранять фото товаров. Папку обязательно включить в резервное копирование.
UPLOAD_DIR=./.data/uploads

# ---------- Поддержка ----------
# Ссылка на чат поддержки в Telegram для покупателей
NEXT_PUBLIC_SUPPORT_TG=https://t.me/nabi_support

# ---------- Аналитика (следующие этапы) ----------
NEXT_PUBLIC_YM_ID=
NEXT_PUBLIC_POSTHOG_KEY=
